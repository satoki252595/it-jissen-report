---
import Base from '../layouts/Base.astro';
import { getReports } from '../lib/reports.js';

const reports = await getReports();
const latest = reports[reports.length - 1];
const base = import.meta.env.BASE_URL;
---

<Base title="ページが見つかりません｜IT実践レポート" description="指定されたページはありません。">
  <main id="main">
    <section class="section not-found">
      <div class="container measure">
        <p class="kicker">404</p>
        <h1>ページが見つかりません</h1>
        <p class="lede">番号が変わったか、アドレスが違います。最新号から読み直せます。</p>
        <a class="button" href={`${base}reports/${latest.date}/`}>最新号を読む</a>
        <p class="meta not-found-link">
          <a href={base}>すべての号</a>
        </p>
      </div>
    </section>
  </main>
</Base>
