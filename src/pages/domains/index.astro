---
import Base from '../../layouts/Base.astro';
import { domains as domainList } from '../../config/domains.js';
import { getReports } from '../../lib/reports.js';

const reports = await getReports();
const base = import.meta.env.BASE_URL;
const domains = domainList.map((domain) => ({
  ...domain,
  count: reports.filter((report) => report.domains.some((item) => item.slug === domain.slug)).length,
}));
---

<Base title="領域｜IT実践レポート" description="11の領域から号をたどる。">
  <main id="main">
    <section class="section">
      <div class="container">
        <p class="kicker">フィルタ</p>
        <h1>領域</h1>
        <p class="lede">11の領域から、気になるものだけをたどれる。トピックがない領域は、その号の本文には出さない。</p>
        <div class="domain-grid">
          {
            domains.map((domain) => (
              <a class="card domain-card" href={`${base}domains/${domain.slug}/`}>
                <strong>
                  <span aria-hidden="true">{domain.emoji}</span>
                  {domain.name}
                </strong>
                <span class={`tag tag-${domain.slug}`}>{domain.count}件</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>
