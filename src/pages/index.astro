---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import IssueList from '../components/IssueList.astro';
import { DOMAINS, getReports } from '../lib/reports.js';

const reports = await getReports();
const latest = reports[reports.length - 1];
const archived = [...reports].reverse();
const base = import.meta.env.BASE_URL;
const description = 'AI・Web・クラウド・データの動きを、現場の判断に使える形で毎日まとめる日刊。';
---

<Base title="IT実践レポート" description={description}>
  <main id="main">
    <section class="section">
      <div class="container measure">
        <p class="kicker">日刊</p>
        <h1>IT実践レポート</h1>
        <p class="lede">{description}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-heading">
      <div class="container measure">
        <p class="kicker">
          第{latest.number}号 · <time datetime={latest.date}>{latest.label}</time>（{latest.weekday}） · {latest.minutes}分で読める
        </p>
        <h2 id="latest-heading">今日の要点</h2>
        <aside class="callout callout-highlight">
          <span class="callout-icon" aria-hidden="true">⚡</span>
          <div>
            <p><strong>今日のハイライト</strong></p>
            <ul>
              {latest.highlights.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </aside>
        <ul class="tag-list">
          {
            latest.domains.map((domain) => (
              <li>
                <a class={`tag tag-${domain.slug}`} href={`${base}domains/${domain.slug}/`}>
                  {domain.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="button" href={`${base}reports/${latest.date}/`}>この号を読む</a>
        <div class="home-domains">
          {
            Object.values(DOMAINS).map((domain) => (
              <a class={`tag tag-${domain.slug}`} href={`${base}domains/${domain.slug}/`}>
                {domain.name}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="archive" aria-labelledby="archive-heading">
      <div class="container">
        <h2 id="archive-heading">これまでの号</h2>
        <p class="meta">{reports.length}件</p>
        <div class="archive-layout">
          <IssueList reports={archived} />
          <Calendar reports={reports} />
        </div>
      </div>
    </section>
  </main>
</Base>
