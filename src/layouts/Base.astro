---
import '../styles/tokens.css';
import '../styles/global.css';
import { getReports } from '../lib/reports.js';

const { title, description, ogType = 'website', published } = Astro.props;
const reports = await getReports();
const latest = reports[reports.length - 1];
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${base}og.png`, Astro.site);
const latestHref = `${base}reports/${latest.date}/`;
const path = Astro.url.pathname;
const homeHref = base;
const domainsHref = `${base}domains/`;
const archiveHref = `${base}#archive`;

function current(href) {
  const normalized = href.replace(/\/$/, '');
  const here = path.replace(/\/$/, '');
  return here === normalized ? 'page' : undefined;
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
        } catch (error) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="IT実践レポート" href={`${base}rss.xml`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="IT実践レポート" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@700&family=Noto+Sans+JP:wght@400;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@700&family=Noto+Sans+JP:wght@400;700&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={homeHref}>IT実践レポート</a>
        <nav class="desktop-nav" aria-label="主要">
          <a href={latestHref} aria-current={current(latestHref)}>最新号</a>
          <a href={archiveHref} aria-current={current(homeHref)}>アーカイブ</a>
          <a href={domainsHref} aria-current={current(domainsHref)}>領域</a>
        </nav>
        <form class="search desktop-tools" action={`${base}search/`} method="get" role="search">
          <label class="visually-hidden" for="q">レポートを検索</label>
          <input id="q" name="q" type="search" placeholder="検索" autocomplete="off" />
        </form>
        <button class="icon-button theme-toggle" id="theme-toggle" type="button" aria-label="テーマを切り替え">
          <span class="when-light">暗</span>
          <span class="when-dark">明</span>
        </button>
        <details class="mobile-menu">
          <summary class="menu-button">メニュー</summary>
          <div class="mobile-panel">
            <form action={`${base}search/`} method="get" role="search">
              <label class="visually-hidden" for="q-mobile">レポートを検索</label>
              <input id="q-mobile" name="q" type="search" placeholder="検索" autocomplete="off" />
            </form>
            <a href={latestHref} aria-current={current(latestHref)}>最新号</a>
            <a href={archiveHref}>アーカイブ</a>
            <a href={domainsHref} aria-current={current(domainsHref)}>領域</a>
          </div>
        </details>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>AI・Web・クラウド・データの動きを、翌日から使える形で毎日まとめる日刊。</p>
        <nav class="footer-links" aria-label="フッター">
          <a href={`${base}rss.xml`}>RSS</a>
          <a href={`${base}domains/`}>領域</a>
          <a href="https://github.com/satoki252595/it-jissen-report">GitHub</a>
        </nav>
      </div>
    </footer>
    <p id="copy-status" class="visually-hidden" aria-live="polite"></p>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
