---
import { monthCalendars } from '../lib/reports.js';

const { reports, latest } = Astro.props;
const months = monthCalendars(reports);
const base = import.meta.env.BASE_URL;
const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
---

<div class="calendars">
  {
    months.map((month) => (
      <section class="calendar" aria-label={month.label}>
        <h3>{month.label}</h3>
        <div class="calendar-week">
          {weekdays.map((day) => (
            <span>{day}</span>
          ))}
        </div>
        <div class="calendar-grid">
          {month.cells.map((cell) =>
            cell?.report ? (
              <a
                href={`${base}reports/${cell.iso}/`}
                aria-label={`${month.month}月${cell.day}日のレポート`}
                aria-current={cell.iso === latest ? 'date' : undefined}
              >
                {cell.day}
              </a>
            ) : (
              <span>{cell ? cell.day : ''}</span>
            ),
          )}
        </div>
      </section>
    ))
  }
</div>
